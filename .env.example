# Copy to .env (development) or .env.production. Never commit real values.
APP_ENV=development
DOCS_ENABLED=true
LOG_LEVEL=DEBUG
AADHAAR_DEMO_MODE=true
USE_SANDBOX_INTEGRATIONS=true
SECRET_KEY=change-me-64-random-chars
# Field-level encryption key for Aadhaar / PAN / bank account (base64, 32 bytes). Use a KMS in production.
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# Local Docker Mongo (default) or MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DB=lendwise
REDIS_URL=redis://redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=lendwise
S3_SECRET_KEY=lendwise-secret
S3_BUCKET=lendwise-documents
S3_REGION=ap-south-1

SMTP_HOST=mailpit
SMTP_PORT=1025
SMS_PROVIDER_API_KEY=
CREDIT_BUREAU_API_KEY=
KYC_PROVIDER_API_KEY=
PAYOUT_PROVIDER_KEY=
PAYOUT_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173

# Manager account created by: python -m scripts.create_manager
MANAGER_NAME=Branch Manager
MANAGER_EMAIL=manager@example.com
MANAGER_MOBILE=9876543210
MANAGER_PASSWORD=change-me
