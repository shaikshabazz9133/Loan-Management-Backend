# Copy to .env:   cp .env.example .env
# These defaults work as-is with `docker compose up -d`. Never commit .env.
APP_ENV=development
DOCS_ENABLED=true
LOG_LEVEL=DEBUG
AADHAAR_DEMO_MODE=true
USE_SANDBOX_INTEGRATIONS=true

# Signs login tokens. Fine for local development; use a long random value anywhere real:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-secret-change-me-for-any-shared-or-real-server

# Database
#   Docker (default): docker-compose.yml sets this to mongodb://mongo:27017 automatically.
#   Backend run without Docker, MongoDB in Docker:  mongodb://localhost:27017
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lendwise

# Frontend address(es) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Manager account, created automatically on `docker compose up`
# (without Docker: python -m scripts.create_manager). Local development login only.
MANAGER_NAME=Branch Manager
MANAGER_EMAIL=manager@example.com
MANAGER_MOBILE=9876543210
MANAGER_PASSWORD=manager123
